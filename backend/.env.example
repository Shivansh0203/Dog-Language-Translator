# Local PostgreSQL settings. These values match backend/app/config.py.
DATABASE_URL=postgresql+psycopg://pawai_user:pawai_password@localhost:5432/pawai
TEST_DATABASE_URL=postgresql+psycopg://pawai_user:pawai_password@localhost:5432/pawai_test

# Keep false for local HTTP development. Set true behind HTTPS.
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:5501
RATE_LIMIT_ENABLED=true
ENVIRONMENT=development

# Contact form delivery. Configure these only on the backend; never expose
# SMTP credentials to the browser or commit them in .env.
CONTACT_OWNER_EMAIL=owner@example.com
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USERNAME=your-smtp-username
CONTACT_SMTP_PASSWORD=your-smtp-password
CONTACT_SMTP_FROM_EMAIL=owner@example.com
CONTACT_SMTP_STARTTLS=true
